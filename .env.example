PORT=3001
NODE_ENV=development
YII_API_URL=http://localhost:8080
YII_TIMEOUT_MS=5000
JWT_SECRET=change-this-jwt-secret-key-in-production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# External Modality Gateway (CT-Scan, X-Ray, MRI, USG, EKG, LIS)
# Mode: dummy (default simulated vendor devices) | live (real external HTTP endpoints)
EXTERNAL_MODALITY_MODE=dummy
EXTERNAL_MODALITY_TIMEOUT_MS=5000
EXTERNAL_CT_SCAN_URL=
EXTERNAL_XRAY_URL=
EXTERNAL_MRI_URL=
EXTERNAL_USG_URL=
EXTERNAL_EKG_URL=
EXTERNAL_LIS_URL=

# Inbound External Webhook HMAC Verification (External RIS/PACS -> backend-node)
EXTERNAL_WEBHOOK_SECRET=change-this-external-webhook-secret
EXTERNAL_WEBHOOK_MAX_SKEW_SEC=300

# Internal Machine-to-Machine Secret (must match backend-yii2 INTERNAL_SERVICE_SECRET)
INTERNAL_SERVICE_SECRET=change-this-internal-service-secret
